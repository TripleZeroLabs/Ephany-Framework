# Copy this file to `.env` and fill in your own values.
# The `.env` file is git-ignored and must be encoded as UTF-8.

# --- Core Django ------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key
DJANGO_DEBUG=True

# Comma-separated. Only needed when DEBUG=False or when serving a real host.
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://example.com,https://*.example.com

# --- API key authentication -------------------------------------------------
# When false (the default), the API is open for local development.
# Create keys with: python manage.py create_apikey "Local Dev"
API_KEY_AUTH_ENABLED=False

# --- Smartsheet integration (optional) --------------------------------------
# Only needed if you use the Smartsheet sync management commands. These IDs are
# specific to your own Smartsheet workspace; the commands will not run without
# them (or their equivalent --sheet-id / --folder-id flags).
#
# Sheet with one row per project, keyed by "Project ID":
#   python manage.py sync_projects_from_smartsheet <API_KEY>
# SMARTSHEET_PROJECTS_SHEET_ID=

# Folder of per-snapshot asset sheets:
#   python manage.py sync_project_snapshots <API_KEY>
# SMARTSHEET_SNAPSHOTS_FOLDER_ID=

# Sheet mapping "Project ID" -> "Smartsheet Project Name".
# Defaults to SMARTSHEET_PROJECTS_SHEET_ID when unset.
# SMARTSHEET_LOOKUP_SHEET_ID=
